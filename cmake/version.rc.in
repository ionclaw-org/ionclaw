#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @IONCLAW_VERSION_MAJOR@,@IONCLAW_VERSION_MINOR@,@IONCLAW_VERSION_PATCH@,0
 PRODUCTVERSION @IONCLAW_VERSION_MAJOR@,@IONCLAW_VERSION_MINOR@,@IONCLAW_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "IonClaw"
            VALUE "FileDescription", "IonClaw AI Agent Orchestrator"
            VALUE "FileVersion", "@IONCLAW_VERSION@"
            VALUE "InternalName", "ionclaw-server"
            VALUE "LegalCopyright", "IonClaw"
            VALUE "OriginalFilename", "ionclaw-server.exe"
            VALUE "ProductName", "IonClaw"
            VALUE "ProductVersion", "@IONCLAW_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
